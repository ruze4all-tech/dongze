async function loadAnimeList(genre = 'all', page = 1) {
    const grid = document.getElementById('animeGrid');
    grid.innerHTML = `<div class="loader"><i class="fas fa-spinner"></i></div>`;

    try {
        const response = await fetch('anime-list.json');
        if (!response.ok) {
            throw new Error(`HTTP ${response.status} - ${response.statusText}`);
        }
        const data = await response.json();
        console.log('Data anime:', data); // Cek di console

        let animeList = data.anime || [];
        if (animeList.length === 0) {
            grid.innerHTML = `<div class="empty-state"><i class="fas fa-frown"></i><p>Belum ada donghua.</p></div>`;
            return;
        }

        // ... sisanya tetap ...
    } catch (error) {
        console.error('Error loading anime list:', error);
        grid.innerHTML = `<div class="empty-state"><i class="fas fa-exclamation-triangle"></i><p>Gagal memuat daftar donghua: ${error.message}</p></div>`;
    }
}
